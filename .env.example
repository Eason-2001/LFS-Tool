# ===== LFS-Tool 本地环境变量模板 =====
# 用法：复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会进仓库。
#   cp .env.example .env

# ---------- 数据库 MySQL ----------
# 库名 / 业务账号（非敏感，一般保持默认即可）
MYSQL_DATABASE=lfs_tool
MYSQL_USER=lfs
# 业务账号密码（强敏感，填真实值，勿提交）
MYSQL_PASSWORD=
# root 密码（强敏感，填真实值，勿提交）
MYSQL_ROOT_PASSWORD=

# 后端连接 MySQL 的参数：库名/账号/密码需与上面保持一致
# DB_HOST 在 compose 内部网络用别名 db；本地直连开发才改成 127.0.0.1
DB_HOST=db
DB_NAME=lfs_tool
DB_USER=lfs
DB_PASSWORD=
DB_PORT=3306

# ---------- 第三方 API Key ----------
# 心知天气（Seniverse）API Key
SENIVERSE_KEY=
# 万维易源 ShowAPI AppKey（紫微排盘 / 生肖运势 / 黄历 等命理接口）
SHOWAPI_KEY=
